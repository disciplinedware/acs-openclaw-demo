# Copy this file to .env and fill in the first block. `make up` fills in the
# generated block. Write each phone in E.164 format: a plus and digits, with no
# spaces. A Mexican mobile can be +52... or +521.... The examples are invented.

# The business number: the WhatsApp (Business) number that OpenClaw uses.
# Example: BUSINESS_PHONE=+447700900001
BUSINESS_PHONE=
# The phone of the host. Approval cards go to this number, and only this
# number can approve them.
# Example: HOST_PHONE=+447700900002
HOST_PHONE=
# Optional: your phone as the stage guest. Reservation CC-1042 (Maria Gonzalez,
# Casa Coral, arrives on 2026-11-11) then belongs to this phone. If empty, each
# phone writes as a stranger. Example: GUEST_PHONE=+447700900200
GUEST_PHONE=
# Optional: a second phone. Reservation CC-1045 (María López) then belongs to
# this phone. Example: SECOND_GUEST_PHONE=+447700900201
SECOND_GUEST_PHONE=
# Optional: the phones that can write to the business number, separated by
# commas, with no spaces. If empty, all phones can write.
# Example: ALLOW_FROM=+447700900200,+447700900201
ALLOW_FROM=

# Set each model as provider/model, and the API key of its provider.
AGENT_MODEL=anthropic/claude-sonnet-5-5
HOST_AGENT_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The Guardian: go, the Go reference of PR #169; or ts, the TypeScript
# reference with PR #229, which runs these rules after #492 and #493 (README.md).
GUARDIAN=go

# on: the host agent has the exec tool of OpenClaw, and the Guardian allows it
# for the host only. The guest agent never has it. off: no agent has it.
OPENCLAW_EXEC_TOOL=on
# off: OpenClaw runs without the ACS adapter, and no Guardian decides. Use it only to compare.
OPENCLAW_ACS_ADAPTER=on

# Generated by `make up` when empty.
# The Guardian's HMAC key is not here: `make up` writes it to .secrets/acs-hmac.
PMS_API_KEY=
OPENCLAW_GATEWAY_TOKEN=

# For make local-up only: checkouts of github.com/disciplinedware/openclaw (branch
# whatsapp-for-business-2026.10.9) and .../agent-control-standard (branch refimpl/openclaw-adapter).
# make up ignores them and builds from GitHub at the pinned commits.
OPENCLAW_REPO=
ACS_REPO=
